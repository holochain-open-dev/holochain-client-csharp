  <PropertyGroup Condition="'$(Embedded)' == 'true'">
    <DefineConstants>$(DefineConstants);EMBEDDED</DefineConstants>
  </PropertyGroup>

  <!-- The lightweight client must never carry desktop conductor executables.  Those resources
       are part of the explicitly selected Embedded package only; this also keeps Unity/mobile
       builds platform-neutral and makes HolochainConductorMode.UseEmbedded fail at its existing
       compile-time contract boundary. -->
  <!-- The conductors used to come in through Properties\Resources.resx, which always bundled both versions. They are now
       embedded directly so each Embedded variant carries only the version(s) it is for (read with
       GetManifestResourceStream, see HoloNETClientBase - EmbeddedBinaries.cs). Resources.resx is kept but no longer built. -->
  <!--<ItemGroup Condition="'$(Embedded)' != 'true'">-->
  <ItemGroup>
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <Compile Remove="Properties\Resources.Designer.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Embedded)' == 'true' And '$(EmbeddedHolochain)' != '0.7.0'">
    <EmbeddedResource Include="Resources\holochain.exe" LogicalName="HoloNET.Embedded.holochain-0.7.1.exe" />
    <EmbeddedResource Include="Resources\hc.exe" LogicalName="HoloNET.Embedded.hc-0.7.1.exe" />
  </ItemGroup>

  <ItemGroup Condition="'$(Embedded)' == 'true' And '$(EmbeddedHolochain)' != '0.7.1'">
    <EmbeddedResource Include="Resources\holochain-0.7.0.exe" LogicalName="HoloNET.Embedded.holochain-0.7.0.exe" />
    <EmbeddedResource Include="Resources\hc-0.7.0.exe" LogicalName="HoloNET.Embedded.hc-0.7.0.exe" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Logos\hc logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="2.5.303" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="Nito.AsyncEx.Context" Version="5.1.2" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="HolochainBinaries\hc.exe">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="HolochainBinaries\holochain.exe">
