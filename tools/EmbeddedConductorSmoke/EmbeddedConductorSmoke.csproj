<Project Sdk="Microsoft.NET.Sdk">

  <!-- Installs one of the offline Embedded packages (for this computer's OS and CPU) from a local folder and proves it starts and connects to its bundled conductor.
       Run it with: dotnet run, setting the properties EmbeddedPackageId (for example NextGenSoftware.Holochain.HoloNET.Client.Embedded.LinuxX64.Holochain071) and EmbeddedPackageSource (the folder of packed nupkg files). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EmbeddedPackageVersion Condition="'$(EmbeddedPackageVersion)' == ''">4.6.0</EmbeddedPackageVersion>
    <RestoreSources Condition="'$(EmbeddedPackageSource)' != ''">$(EmbeddedPackageSource);https://api.nuget.org/v3/index.json</RestoreSources>
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(EmbeddedPackageId)" Version="$(EmbeddedPackageVersion)" />
  </ItemGroup>

</Project>
