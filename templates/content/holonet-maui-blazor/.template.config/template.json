{
  "$schema": "http://json.schemastore.org/template",
  "author": "NextGen Software Ltd",
  "classifications": [
    "HoloNET",
    "Holochain",
    "MAUI",
    "Blazor",
    "Mobile"
  ],
  "identity": "NextGenSoftware.Holochain.HoloNET.Templates.MauiBlazor",
  "name": "HoloNET .NET MAUI Blazor Hybrid app",
  "description": "A .NET MAUI Blazor Hybrid app with HoloNET already wired in: choose the HoloNET library (API, Client, ORM or HyperNET) and whether to bundle the Holochain conductor.",
  "shortName": "holonet-maui-blazor",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "HoloNETApp",
  "preferNameDirectory": true,
  "symbols": {
    "HoloNET": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "api",
      "description": "Which HoloNET library the app uses.",
      "choices": [
        {
          "choice": "api",
          "description": "HoloNET API: one line to save, load, delete, share and message (simplest)."
        },
        {
          "choice": "client",
          "description": "HoloNET Client: full control of the conductor, zome calls and signals."
        },
        {
          "choice": "orm",
          "description": "HoloNET ORM: save and load your own C# classes (includes the Client)."
        },
        {
          "choice": "hypernet",
          "description": "HoloNET HyperNET: real-time player-to-player messaging (includes the Client)."
        }
      ]
    },
    "HoloNETVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "4.6.0",
      "description": "The HoloNET package version.",
      "replaces": "HOLONET_VERSION"
    },
    "OS": {
      "type": "bind",
      "binding": "env:OS"
    },
    "UseApi": {
      "type": "computed",
      "value": "(HoloNET == \"api\")"
    },
    "UseClient": {
      "type": "computed",
      "value": "(HoloNET == \"client\")"
    },
    "UseOrm": {
      "type": "computed",
      "value": "(HoloNET == \"orm\")"
    },
    "UseHyperNet": {
      "type": "computed",
      "value": "(HoloNET == \"hypernet\")"
    },
    "LibraryId": {
      "type": "generated",
      "generator": "switch",
      "replaces": "HOLONET_LIBRARY_ID",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(UseApi)",
            "value": "API"
          },
          {
            "condition": "(UseClient)",
            "value": "Client"
          },
          {
            "condition": "(UseOrm)",
            "value": "ORM"
          },
          {
            "condition": "(UseHyperNet)",
            "value": "HyperNET"
          }
        ]
      }
    },
    "LibraryName": {
      "type": "generated",
      "generator": "switch",
      "replaces": "HOLONET_LIBRARY_NAME",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(UseApi)",
            "value": "API"
          },
          {
            "condition": "(UseClient)",
            "value": "Client"
          },
          {
            "condition": "(UseOrm)",
            "value": "ORM"
          },
          {
            "condition": "(UseHyperNet)",
            "value": "HyperNET"
          }
        ]
      }
    },
    "PackageSuffix": {
      "type": "generated",
      "generator": "switch",
      "replaces": "HOLONET_PKG_SUFFIX",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(UseEmbedded && false)",
            "value": ".Embedded.Holochain071"
          },
          {
            "condition": "(UseEmbedded && false)",
            "value": ".Embedded.Holochain070"
          },
          {
            "condition": "(UseEmbedded)",
            "value": ".Embedded"
          },
          {
            "condition": "(!UseEmbedded)",
            "value": ""
          }
        ]
      }
    },
    "PhoneRuntime": {
      "type": "computed",
      "value": "true"
    },
    "UseEmbedded": {
      "type": "computed",
      "value": "false"
    }
  },
  "sources": [
    {
      "exclude": [
        "**/bin/**",
        "**/obj/**",
        "**/.vs/**",
        "**/*.user",
        "**/.sandbox/**"
      ],
      "modifiers": []
    }
  ],
  "postActions": [
    {
      "description": "Restore the NuGet packages",
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
